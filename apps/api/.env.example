# Ambiente
NODE_ENV=development
PORT=3000
# Origem do front (CORS). Várias origens separadas por vírgula.
CORS_ORIGIN=http://localhost:5173

# Banco (SQL Server do docker-compose). A senha deve bater com MSSQL_SA_PASSWORD.
DATABASE_URL="sqlserver://localhost:1433;database=Financeiro;user=sa;password=Financeiro@2026;encrypt=true;trustServerCertificate=true"
# Opcional: banco auxiliar do `prisma migrate dev`. Sem ele, o Prisma cria e apaga um temporário.
# SHADOW_DATABASE_URL=

# Autenticação. Gere segredos com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true em produção (HTTPS). Com front e API em domínios diferentes, use também COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Endereço do front, usado nos links de e-mail (recuperação de senha)
APP_URL=http://localhost:5173

# E-mail (SMTP). Sem SMTP_HOST, em desenvolvimento o e-mail aparece no terminal da API.
# Obrigatório em produção.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Financeiro <nao-responda@exemplo.com>"

# Limite de tentativas por IP em login, cadastro e recuperação de senha
RATE_LIMIT_ENABLED=true
# true atrás de proxy reverso (nginx, load balancer), para limitar pelo IP real
TRUST_PROXY=false

# Super administradores (separados por vírgula). Promovidos ao subir a API ou ao se cadastrar.
SUPER_ADMIN_EMAILS=
