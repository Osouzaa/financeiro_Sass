// Modelo de dados do MVP (ver especificação).
//
// Convenções:
// - Tabelas e colunas em PascalCase no SQL Server; campos em camelCase no código.
// - Valores monetários em DECIMAL(19,2); a aplicação calcula em centavos.
// - Datas de calendário em DATE (sem hora): competência, caixa, vencimento.
// - SQL Server não tem enum: tipos e status são VARCHAR validados pela aplicação
//   (os valores aceitos ficam em @financeiro/shared/enums).
// - Relações com NoAction: o SQL Server rejeita múltiplos caminhos de cascata,
//   então exclusões são feitas explicitamente pelos services.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // CommonJS sem extensão nos imports, compatível com o build padrão do NestJS
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "sqlserver"
}

model User {
  id           String @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  name         String @map("Name") @db.NVarChar(100)
  email        String @unique(map: "UQ_Users_Email") @map("Email") @db.NVarChar(254)
  passwordHash String @map("PasswordHash") @db.NVarChar(100)

  /// Foto do perfil (JPEG/PNG/WebP de até 1 MB, já redimensionada pelo front)
  avatarData      Bytes?    @map("AvatarData") @db.VarBinary(Max)
  avatarMimeType  String?   @map("AvatarMimeType") @db.VarChar(20)
  avatarUpdatedAt DateTime? @map("AvatarUpdatedAt") @db.DateTime2

  /// Preferências de alertas
  alertDueSoon         Boolean @default(true) @map("AlertDueSoon")
  alertDueDays         Int     @default(3) @map("AlertDueDays") @db.TinyInt
  alertBudget          Boolean @default(true) @map("AlertBudget")
  alertBudgetPercent   Int     @default(80) @map("AlertBudgetPercent") @db.TinyInt
  alertNegativeBalance Boolean @default(true) @map("AlertNegativeBalance")

  /// Confirmação do e-mail (link enviado no cadastro e ao trocar o e-mail)
  emailVerifiedAt DateTime? @map("EmailVerifiedAt") @db.DateTime2
  /// Aceite dos Termos de uso e da Política de privacidade
  termsAcceptedAt DateTime? @map("TermsAcceptedAt") @db.DateTime2
  termsVersion    String?   @map("TermsVersion") @db.VarChar(20)
  /// USER | SUPER_ADMIN
  role            String    @default("USER") @map("Role") @db.VarChar(20)
  /// Quando usou o teste grátis (um por pessoa, para sempre)
  trialUsedAt     DateTime? @map("TrialUsedAt") @db.DateTime2
  /// ACTIVE | SUSPENDED
  status          String    @default("ACTIVE") @map("Status") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  refreshTokens RefreshToken[]
  cpf           UserCpf?
  resetTokens   PasswordResetToken[]
  phone         UserPhone?
  emailTokens   EmailVerificationToken[]
  subscription  Subscription?
  auditEntries  AdminAuditLog[]
  checkouts     CheckoutSession[]
  payments      Payment[]
  accounts      Account[]
  categories    Category[]
  invoices      Invoice[]
  transactions  Transaction[]
  recurrences   Recurrence[]
  budgets       Budget[]

  @@map("Users")
}

/// Celular para o assistente no WhatsApp (opcional, cadastrado depois). Em E.164.
model UserPhone {
  userId        String    @id @map("UserId") @db.UniqueIdentifier
  phone         String    @unique(map: "UQ_UserPhones_Phone") @map("Phone") @db.VarChar(16)
  /// Consentimento explícito para receber mensagens
  whatsappOptIn Boolean   @default(false) @map("WhatsappOptIn")
  optInAt       DateTime? @map("OptInAt") @db.DateTime2
  /// Confirmado por código no WhatsApp, quando o assistente existir
  verifiedAt    DateTime? @map("VerifiedAt") @db.DateTime2
  createdAt     DateTime  @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt     DateTime  @updatedAt @map("UpdatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserPhones_Users")

  @@map("UserPhones")
}

/// Link de confirmação de e-mail. Só o hash SHA-256 do token; vale uma vez.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId    String    @map("UserId") @db.UniqueIdentifier
  tokenHash String    @unique(map: "UQ_EmailVerificationTokens_TokenHash") @map("TokenHash") @db.Char(64)
  /// E-mail que o link confirma: se a pessoa trocar de novo antes, o link antigo não vale
  email     String    @map("Email") @db.NVarChar(254)
  expiresAt DateTime  @map("ExpiresAt") @db.DateTime2
  usedAt    DateTime? @map("UsedAt") @db.DateTime2
  createdAt DateTime  @default(now()) @map("CreatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_EmailVerificationTokens_Users")

  @@index([userId], map: "IX_EmailVerificationTokens_UserId")
  @@map("EmailVerificationTokens")
}

/// Plano de assinatura. Limites nulos = sem limite. Editado pelo super administrador.
model Plan {
  id             String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  code           String   @unique(map: "UQ_Plans_Code") @map("Code") @db.VarChar(30)
  name           String   @map("Name") @db.NVarChar(40)
  description    String   @default("") @map("Description") @db.NVarChar(200)
  priceAmount    Decimal  @default(0) @map("PriceAmount") @db.Decimal(19, 2)
  /// MONTH | YEAR
  interval       String   @default("MONTH") @map("Interval") @db.VarChar(10)
  /// Aparece na página de planos
  isPublic       Boolean  @default(true) @map("IsPublic")
  /// Pode ser atribuído a novas assinaturas
  isActive       Boolean  @default(true) @map("IsActive")
  highlighted    Boolean  @default(false) @map("Highlighted")
  sortOrder      Int      @default(0) @map("SortOrder")
  /// Lista de destaques para a página de planos (JSON: string[])
  features       String   @default("[]") @map("Features") @db.NVarChar(2000)
  maxAccounts    Int?     @map("MaxAccounts")
  maxCards       Int?     @map("MaxCards")
  maxRecurrences Int?     @map("MaxRecurrences")
  maxBudgets     Int?     @map("MaxBudgets")
  projectionDays Int      @default(30) @map("ProjectionDays")
  whatsapp       Boolean  @default(false) @map("Whatsapp")
  /// Dias grátis na primeira assinatura
  trialDays      Int      @default(0) @map("TrialDays")
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt      DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  subscriptions Subscription[]
  checkouts     CheckoutSession[]

  @@map("Plans")
}

/// Assinatura atual da conta (uma por usuário). Sem assinatura, vale o plano grátis.
model Subscription {
  id               String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId           String    @unique(map: "UQ_Subscriptions_UserId") @map("UserId") @db.UniqueIdentifier
  planId           String    @map("PlanId") @db.UniqueIdentifier
  /// TRIALING | ACTIVE | PAST_DUE | CANCELED
  status           String    @map("Status") @db.VarChar(20)
  currentPeriodEnd DateTime? @map("CurrentPeriodEnd") @db.Date
  /// MANUAL (definida pelo super admin) | MERCADO_PAGO
  provider         String    @default("MANUAL") @map("Provider") @db.VarChar(20)
  /// Id da assinatura no provedor de pagamento
  providerRef      String?   @map("ProviderRef") @db.VarChar(100)
  /// Fim do teste grátis, se a assinatura começou com teste
  trialEndsAt      DateTime? @map("TrialEndsAt") @db.Date
  canceledAt       DateTime? @map("CanceledAt") @db.DateTime2
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt        DateTime  @updatedAt @map("UpdatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Subscriptions_Users")
  plan Plan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Subscriptions_Plans")

  @@index([planId], map: "IX_Subscriptions_PlanId")
  @@map("Subscriptions")
}

/// Cada ida ao Mercado Pago para assinar. O id vai como external_reference: é ele
/// que liga a assinatura do Mercado Pago ao usuário, sem depender do e-mail.
model CheckoutSession {
  id          String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId      String   @map("UserId") @db.UniqueIdentifier
  planId      String   @map("PlanId") @db.UniqueIdentifier
  /// PENDING | AUTHORIZED | CANCELED
  status      String   @default("PENDING") @map("Status") @db.VarChar(20)
  trialDays   Int      @default(0) @map("TrialDays")
  amount      Decimal  @map("Amount") @db.Decimal(19, 2)
  /// Id da assinatura (preapproval) no Mercado Pago
  providerRef String?  @unique(map: "UQ_CheckoutSessions_ProviderRef") @map("ProviderRef") @db.VarChar(100)
  initPoint   String?  @map("InitPoint") @db.NVarChar(500)
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_CheckoutSessions_Users")
  plan Plan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_CheckoutSessions_Plans")

  @@index([userId], map: "IX_CheckoutSessions_UserId")
  @@map("CheckoutSessions")
}

/// Cobrança feita pelo provedor. Registro financeiro: fica mesmo se a conta for excluída.
model Payment {
  id                String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  /// Nulo se a conta foi excluída depois
  userId            String?   @map("UserId") @db.UniqueIdentifier
  /// MERCADO_PAGO
  provider          String    @map("Provider") @db.VarChar(20)
  /// Id da cobrança no provedor (authorized_payment do Mercado Pago)
  providerPaymentId String    @unique(map: "UQ_Payments_ProviderPaymentId") @map("ProviderPaymentId") @db.VarChar(100)
  /// Id da assinatura no provedor
  providerRef       String?   @map("ProviderRef") @db.VarChar(100)
  amount            Decimal   @map("Amount") @db.Decimal(19, 2)
  /// PENDING | APPROVED | REJECTED | REFUNDED
  status            String    @map("Status") @db.VarChar(20)
  description       String    @map("Description") @db.NVarChar(200)
  payerEmail        String?   @map("PayerEmail") @db.NVarChar(254)
  paidAt            DateTime? @map("PaidAt") @db.DateTime2
  createdAt         DateTime  @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt         DateTime  @updatedAt @map("UpdatedAt") @db.DateTime2

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_Payments_Users")

  @@index([userId], map: "IX_Payments_UserId")
  @@index([createdAt], map: "IX_Payments_CreatedAt")
  @@map("Payments")
}

/// Aviso recebido do provedor. Guardado para auditoria e para não processar duas vezes.
model WebhookEvent {
  id          String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  provider    String    @map("Provider") @db.VarChar(20)
  /// x-request-id do Mercado Pago: identifica a entrega
  requestId   String?   @unique(map: "UQ_WebhookEvents_RequestId") @map("RequestId") @db.VarChar(100)
  type        String    @map("Type") @db.VarChar(60)
  resourceId  String?   @map("ResourceId") @db.VarChar(100)
  /// RECEIVED | PROCESSED | IGNORED | FAILED | REJECTED
  status      String    @map("Status") @db.VarChar(20)
  error       String?   @map("Error") @db.NVarChar(1000)
  processedAt DateTime? @map("ProcessedAt") @db.DateTime2
  createdAt   DateTime  @default(now()) @map("CreatedAt") @db.DateTime2

  @@index([createdAt], map: "IX_WebhookEvents_CreatedAt")
  @@map("WebhookEvents")
}

/// Registro do que o super administrador fez (trocar plano, suspender, editar plano).
model AdminAuditLog {
  id         String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  /// Quem fez; nulo se a conta foi excluída depois
  actorId    String?  @map("ActorId") @db.UniqueIdentifier
  action     String   @map("Action") @db.VarChar(50)
  targetType String   @map("TargetType") @db.VarChar(30)
  targetId   String?  @map("TargetId") @db.VarChar(64)
  details    String?  @map("Details") @db.NVarChar(2000)
  createdAt  DateTime @default(now()) @map("CreatedAt") @db.DateTime2

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_AdminAuditLogs_Users")

  @@index([createdAt], map: "IX_AdminAuditLogs_CreatedAt")
  @@map("AdminAuditLogs")
}

/// CPF do usuário (1:1). Em tabela própria porque, no SQL Server, uma coluna UNIQUE
/// aceita só um NULL, e contas antigas não têm CPF. Guardado só com os 11 dígitos.
model UserCpf {
  userId    String   @id @map("UserId") @db.UniqueIdentifier
  cpf       String   @unique(map: "UQ_UserCpfs_Cpf") @map("Cpf") @db.Char(11)
  createdAt DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserCpfs_Users")

  @@map("UserCpfs")
}

/// Pedido de redefinição de senha. Guardamos só o hash SHA-256 do token do link;
/// ele vale por pouco tempo e só uma vez.
model PasswordResetToken {
  id        String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId    String    @map("UserId") @db.UniqueIdentifier
  tokenHash String    @unique(map: "UQ_PasswordResetTokens_TokenHash") @map("TokenHash") @db.Char(64)
  expiresAt DateTime  @map("ExpiresAt") @db.DateTime2
  usedAt    DateTime? @map("UsedAt") @db.DateTime2
  /// IP de quem pediu, para auditoria de abuso
  requestIp String?   @map("RequestIp") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("CreatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_PasswordResetTokens_Users")

  @@index([userId], map: "IX_PasswordResetTokens_UserId")
  @@map("PasswordResetTokens")
}

/// Refresh tokens com rotação. Guardamos apenas o hash SHA-256 do token.
model RefreshToken {
  id         String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId     String    @map("UserId") @db.UniqueIdentifier
  tokenHash  String    @unique(map: "UQ_RefreshTokens_TokenHash") @map("TokenHash") @db.Char(64)
  expiresAt  DateTime  @map("ExpiresAt") @db.DateTime2
  revokedAt  DateTime? @map("RevokedAt") @db.DateTime2
  /// Token que substituiu este na rotação; usado para detectar reutilização.
  replacedBy String?   @map("ReplacedBy") @db.UniqueIdentifier
  userAgent  String?   @map("UserAgent") @db.NVarChar(300)
  createdAt  DateTime  @default(now()) @map("CreatedAt") @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_RefreshTokens_Users")

  @@index([userId], map: "IX_RefreshTokens_UserId")
  @@map("RefreshTokens")
}

model Account {
  id                 String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId             String   @map("UserId") @db.UniqueIdentifier
  name               String   @map("Name") @db.NVarChar(80)
  /// CHECKING | WALLET | CREDIT_CARD
  type               String   @map("Type") @db.VarChar(20)
  initialBalance     Decimal  @default(0) @map("InitialBalance") @db.Decimal(19, 2)
  initialBalanceDate DateTime @map("InitialBalanceDate") @db.Date
  color              String?  @map("Color") @db.VarChar(9)
  /// Somente cartão de crédito
  closingDay         Int?     @map("ClosingDay") @db.TinyInt
  dueDay             Int?     @map("DueDay") @db.TinyInt
  creditLimit        Decimal? @map("CreditLimit") @db.Decimal(19, 2)
  /// Conta corrente padrão para pagar a fatura
  paymentAccountId   String?  @map("PaymentAccountId") @db.UniqueIdentifier
  archived           Boolean  @default(false) @map("Archived")
  createdAt          DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt          DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  user           User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Accounts_Users")
  paymentAccount Account?      @relation("CardPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Accounts_PaymentAccount")
  paidCards      Account[]     @relation("CardPaymentAccount")
  invoices       Invoice[]
  transactions   Transaction[]
  recurrences    Recurrence[]

  @@index([userId], map: "IX_Accounts_UserId")
  @@map("Accounts")
}

model Category {
  id        String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId    String   @map("UserId") @db.UniqueIdentifier
  name      String   @map("Name") @db.NVarChar(60)
  /// INCOME | EXPENSE
  type      String   @map("Type") @db.VarChar(10)
  parentId  String?  @map("ParentId") @db.UniqueIdentifier
  color     String?  @map("Color") @db.VarChar(9)
  icon      String?  @map("Icon") @db.VarChar(40)
  archived  Boolean  @default(false) @map("Archived")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Categories_Users")
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Categories_Parent")
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  recurrences  Recurrence[]
  budgets      Budget[]

  @@index([userId, type], map: "IX_Categories_UserId_Type")
  @@map("Categories")
}

model Invoice {
  id             String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId         String   @map("UserId") @db.UniqueIdentifier
  accountId      String   @map("AccountId") @db.UniqueIdentifier
  /// Mês do vencimento, YYYY-MM
  referenceMonth String   @map("ReferenceMonth") @db.Char(7)
  closingDate    DateTime @map("ClosingDate") @db.Date
  dueDate        DateTime @map("DueDate") @db.Date
  /// Reservado: o status (OPEN | CLOSED | PARTIALLY_PAID | PAID) é calculado na leitura
  /// a partir das datas e dos pagamentos ligados à fatura (invoices/invoice-math.ts)
  status         String   @default("OPEN") @map("Status") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt      DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Invoices_Users")
  account      Account       @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Invoices_Accounts")
  transactions Transaction[]

  @@unique([accountId, referenceMonth], map: "UQ_Invoices_Account_Month")
  @@index([userId, dueDate], map: "IX_Invoices_UserId_DueDate")
  @@map("Invoices")
}

model Transaction {
  id                 String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId             String    @map("UserId") @db.UniqueIdentifier
  accountId          String    @map("AccountId") @db.UniqueIdentifier
  /// Obrigatória para receita/despesa, nula para transferência
  categoryId         String?   @map("CategoryId") @db.UniqueIdentifier
  /// INCOME | EXPENSE | TRANSFER
  type               String    @map("Type") @db.VarChar(10)
  /// Sempre positivo; o tipo define o sinal
  amount             Decimal   @map("Amount") @db.Decimal(19, 2)
  description        String    @map("Description") @db.NVarChar(200)
  notes              String?   @map("Notes") @db.NVarChar(1000)
  /// Quando o gasto aconteceu (orçamento e relatórios)
  competenceDate     DateTime  @map("CompetenceDate") @db.Date
  /// Quando o dinheiro sai/entra na conta (saldo e projeção). Nulo em compras no cartão.
  cashDate           DateTime? @map("CashDate") @db.Date
  /// PLANNED | PAID
  status             String    @map("Status") @db.VarChar(10)
  invoiceId          String?   @map("InvoiceId") @db.UniqueIdentifier
  /// Liga as duas pontas de uma transferência
  transferGroupId    String?   @map("TransferGroupId") @db.UniqueIdentifier
  /// Ponta da transferência: IN (entra nesta conta) | OUT (sai desta conta)
  transferDirection  String?   @map("TransferDirection") @db.VarChar(3)
  recurrenceId       String?   @map("RecurrenceId") @db.UniqueIdentifier
  /// Data prevista pela recorrência antes de qualquer edição
  originalDate       DateTime? @map("OriginalDate") @db.Date
  /// Editado individualmente: não é mais sobrescrito pela recorrência
  detached           Boolean   @default(false) @map("Detached")
  installmentGroupId String?   @map("InstallmentGroupId") @db.UniqueIdentifier
  installmentNumber  Int?      @map("InstallmentNumber") @db.SmallInt
  installmentTotal   Int?      @map("InstallmentTotal") @db.SmallInt
  createdAt          DateTime  @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt          DateTime  @updatedAt @map("UpdatedAt") @db.DateTime2

  user       User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Transactions_Users")
  account    Account     @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Transactions_Accounts")
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Transactions_Categories")
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Transactions_Invoices")
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Transactions_Recurrences")

  @@index([userId, cashDate], map: "IX_Transactions_UserId_CashDate")
  @@index([userId, competenceDate], map: "IX_Transactions_UserId_CompetenceDate")
  @@index([invoiceId], map: "IX_Transactions_InvoiceId")
  @@index([recurrenceId], map: "IX_Transactions_RecurrenceId")
  @@index([transferGroupId], map: "IX_Transactions_TransferGroupId")
  @@index([installmentGroupId], map: "IX_Transactions_InstallmentGroupId")
  @@map("Transactions")
}

model Recurrence {
  id             String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId         String    @map("UserId") @db.UniqueIdentifier
  accountId      String    @map("AccountId") @db.UniqueIdentifier
  categoryId     String?   @map("CategoryId") @db.UniqueIdentifier
  /// INCOME | EXPENSE
  type           String    @map("Type") @db.VarChar(10)
  amount         Decimal   @map("Amount") @db.Decimal(19, 2)
  description    String    @map("Description") @db.NVarChar(200)
  /// WEEKLY | MONTHLY | YEARLY
  frequency      String    @map("Frequency") @db.VarChar(10)
  /// Dia do mês (MONTHLY/YEARLY) ou da semana 0-6 (WEEKLY)
  day            Int       @map("Day") @db.TinyInt
  startDate      DateTime  @map("StartDate") @db.Date
  endDate        DateTime? @map("EndDate") @db.Date
  /// Até onde os lançamentos previstos já foram materializados
  generatedUntil DateTime? @map("GeneratedUntil") @db.Date
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt      DateTime  @updatedAt @map("UpdatedAt") @db.DateTime2

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Recurrences_Users")
  account      Account       @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Recurrences_Accounts")
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Recurrences_Categories")
  transactions Transaction[]

  @@index([userId], map: "IX_Recurrences_UserId")
  @@map("Recurrences")
}

model Budget {
  id          String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId      String   @map("UserId") @db.UniqueIdentifier
  categoryId  String   @map("CategoryId") @db.UniqueIdentifier
  /// YYYY-MM
  month       String   @map("Month") @db.Char(7)
  limitAmount Decimal  @map("LimitAmount") @db.Decimal(19, 2)
  createdAt   DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt   DateTime @updatedAt @map("UpdatedAt") @db.DateTime2

  user     User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Budgets_Users")
  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Budgets_Categories")

  @@unique([userId, categoryId, month], map: "UQ_Budgets_User_Category_Month")
  @@map("Budgets")
}
